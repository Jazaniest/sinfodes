{
  "name": "sinfodes",
  "private": true,
  "version": "0.2.0",
  "packageManager": "pnpm@10.14.0",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "dev": "pnpm --filter @sinfodes/web dev",
    "dev:api": "pnpm --filter @sinfodes/api dev",
    "dev:nyata": "pnpm --filter @sinfodes/web dev --mode nyata",
    "preview": "pnpm --filter @sinfodes/web preview",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:watch": "pnpm --filter @sinfodes/web test:watch"
  }
}
