# Contoh pengaturan server. Nilai asli ada di apps/api/.env.local (tidak masuk git; dibuat skrip `db:siapkan`).
# Jangan menaruh rahasia asli di berkas ini.

# pengembangan | uji | staging | produksi
LINGKUNGAN=pengembangan
PORT=3001
DOMAIN_INDUK=sinfodes.localhost

# Hanya untuk `db:siapkan` (superuser PostgreSQL). Dihapus dari .env.local bila tidak dipakai lagi.
PG_SUPERUSER_URL=

# Diisi `db:siapkan`: satu URL per peran basis data.
DB_URL_MIGRASI=
DB_URL_DESA=
DB_URL_KABUPATEN=
DB_URL_KONSOL=
DB_URL_PUBLIK=

# Diisi `db:siapkan`: 32 bita acak dalam base64.
KUNCI_UTAMA=
KUNCI_INDEKS=
KID_AKTIF=k1

# Awalan cookie sesi. Bawaan __Host-; __Secure- hanya untuk pengembangan bila peramban menolak __Host- di *.localhost.
COOKIE_AWALAN=__Host-
